# Required. Signs session and gallery-access cookies. Use a long random string.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional. Where the SQLite database and uploaded photos live. Defaults to ./storage
# DATA_DIR=/var/lib/kadraj

# Optional. Base URL used when building the share link shown to photographers.
# Set this when running behind a proxy that rewrites the Host header.
# APP_ORIGIN=https://galeri.ornek.com
