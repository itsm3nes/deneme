# Sitenin yayınlandığı adres. Metadata (canonical, Open Graph), sitemap ve
# robots.txt bu değerden üretilir. Ayarlanmazsa https://www.mevadis.com.tr kullanılır.
# NEXT_PUBLIC_SITE_URL=https://www.mevadis.com.tr

# Randevu formu taleplerinin yazıldığı klasör. Varsayılan: ./storage
# Talepler DATA_DIR/randevu-talepleri.jsonl dosyasına eklenir.
# DATA_DIR=/var/lib/mevadis
