# Sitenin yayınlandığı gerçek adres. Metadata (canonical, Open Graph), sitemap
# ve robots.txt bu değerden üretilir.
#
# TANIMLANMAZSA site "taslak" sayılır: robots.txt tüm taramayı kapatır ve
# sayfalar noindex olur. Yayına geçerken mutlaka tanımlayın.
# NEXT_PUBLIC_SITE_URL=https://mevadisyalova.com


# ---------------------------------------------------------------------------
# Yönetim paneli (/yonetim)
# ---------------------------------------------------------------------------

# Panelin parolası. TANIMLANMAZSA PANEL TAMAMEN KAPALIDIR (en az 8 karakter).
# Uzun ve tahmin edilemez bir değer seçin; kimseyle paylaşmayın.
# ADMIN_PASSWORD=

# Oturum çerezini imzalayan gizli anahtar. Boş bırakılırsa parolanın kendisinden
# türetilir. Parolayı değiştirince tüm oturumlar düşer. İsterseniz ayrıca verin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_SECRET=

# Panelden yapılan değişikliklerin GitHub'a işlenmesi için (Vercel'de zorunlu —
# orada dosya sistemi salt okunurdur). Tanımlanmazsa değişiklikler yerel
# content/*.json dosyalarına yazılır.
#
# Token: GitHub → Settings → Developer settings → Personal access tokens →
# Fine-grained token; yalnızca bu depoya "Contents: Read and write" izni verin.
# GITHUB_TOKEN=
# GITHUB_REPO=itsm3nes/deneme
# GITHUB_BRANCH=claude/yalova-meva-dental-website-uapcgn

# Not: Randevu formu sunucu kullanmaz — talepler WhatsApp mesajına dönüştürülür.
# Bu yüzden e-posta/SMTP ya da veritabanı ayarı gerekmez.
